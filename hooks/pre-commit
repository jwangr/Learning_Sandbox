# !/bin/bash

# Using client-side git hook to validate branch names before committing
# Runs on developer's local machine

BRANCH_NAME=$(git rev-parse --abbrev-ref HEAD) # Get the current branch name
BRANCH_REGEX='^YAS-[0-9]+-[A-Za-z]+$' # Define the regex pattern

# Check if the branch name matches the pattern
if ! [[ "$BRANCH_NAME" =~ $BRANCH_REGEX ]]; then
    echo "The branch name '$BRANCH_NAME' is not valid. Name the branch in the format YAS-<number>-<description>."
    exit 1 # Exit with non-zero status to prevent the commit
fi